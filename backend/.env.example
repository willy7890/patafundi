# PataFundi Backend - Environment Variables
# Copy to .env and adjust as needed

APP_NAME=PataFundi
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (works with docker-compose postgres)
DATABASE_URL=postgresql://patafundi:patafundi_secret@localhost:5432/patafundi

# Security
SECRET_KEY=change-this-to-a-long-random-secret-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Redis
REDIS_URL=redis://localhost:6379/0

# Payment Mode (development = fake payments, no real money)
PAYMENT_MODE=development

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Infrastructure mode
INFRASTRUCTURE_MODE=FREE
